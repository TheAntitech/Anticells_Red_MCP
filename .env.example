# anticells_red_mcp environment example; this file is not loaded automatically.
# Export variables in the shell or set them in the MCP client environment.
# ANTICELLS_RED_MCP_ENV_FILE explicitly loads server and saved-profile settings.
# Egress policy and request/history caps below read the process environment only;
# pass those through shell exports or the MCP client's env/environment object.
# Optional saved profiles JSON (absolute paths recommended):
# ANTICELLS_RED_MCP_TARGETS_FILE=/absolute/path/to/targets.json
# ANTICELLS_RED_MCP_ENV_FILE=/absolute/path/to/.env
# The profiles file can also list env_files, resolved relative to that JSON file.
# API_KEY=private-key-for-the-custom-target-example
# Environment-backed saved profiles must match ANTICELLS_RED_MCP_TARGET_API_URL.
# For the custom profile example, set it to https://gateway.example/chat (replace both URLs).
# Process credentials require ANTICELLS_RED_MCP_TEMPLATE_ENV; explicitly loaded file values do not.
# Inline definitions cannot use ${env.*}, even when an API origin is configured.
# Optional local SQLite file. If empty, use the per-user application data directory.
ANTICELLS_RED_MCP_DATABASE_PATH=
# Automatic migrations/seeding are enabled by default.
# Set false to require an existing initialized catalog and read it without writes.
# ANTICELLS_RED_MCP_CATALOG_AUTO_SETUP=true
# Optional private directory for the default catalog.sqlite3 file:
# ANTICELLS_RED_MCP_STATE_DIR=/absolute/path/private/anticells-catalog
# Optional report directory; defaults to <state directory>/reports.
# Reports are saved automatically in reports.sqlite3; generated files go in exports/.
# ANTICELLS_RED_MCP_REPORTS_DIR=/absolute/path/private/anticells-reports
ANTICELLS_RED_MCP_WORKERS=8
ANTICELLS_RED_MCP_MUTATION_RATE=0.3
# ----- 1.1.0 hardening knobs -----
# Egress and cap settings in this section must be process environment variables.
# ANTICELLS_RED_MCP_TEMPLATE_ENV is also a process-only allowlist setting.
# Egress policy. Default DENIES loopback, private, link-local, multicast,
# reserved and unspecified addresses. Set to true to allow research against
# a lab you fully control.
# ANTICELLS_RED_MCP_ALLOW_PRIVATE_TARGETS=false
# Exact-host or trailing-wildcard allow-list, comma-separated.
# ANTICELLS_RED_MCP_TARGET_ALLOW_HOSTS=api.openai.com,*.internal.example
# Always-deny list, applied before the allow-list.
# ANTICELLS_RED_MCP_TARGET_DENY_HOSTS=metadata.google.internal
# DNS resolution timeout for the egress check (seconds, 0 < x <= 60).
# ANTICELLS_RED_MCP_RESOLVE_TIMEOUT_SECONDS=2.0
# Which process env vars become visible to target templates (${env.NAME}).
# Default is EMPTY. Inline targets cannot read ${env.*} even when a value
# is listed here; only operator-authored saved profiles can.
# ANTICELLS_RED_MCP_TEMPLATE_ENV=OPENAI_API_KEY
# Memory and request bounds (set 0 to disable the cap).
# ANTICELLS_RED_MCP_MAX_HISTORY=2000
# ANTICELLS_RED_MCP_MAX_REQUESTS_PER_CALL=20
# ANTICELLS_RED_MCP_MAX_REQUESTS_PER_SESSION_PER_MIN=500
ANTICELLS_RED_MCP_TARGET_MODEL=
ANTICELLS_RED_MCP_TARGET_API_URL=
# Optional bearer credential, bound to the origin in ANTICELLS_RED_MCP_TARGET_API_URL. Keep the value private.
ANTICELLS_RED_MCP_TARGET_API_KEY=
# ANTICELLS_RED_MCP_LOG_DIR defaults to ~/.local/state/anticells_red_mcp/logs.
# ANTICELLS_RED_MCP_PYTHON can select the launcher and installer interpreter.
